{
  "name": "mottenai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "db:migrate:local": "wrangler d1 migrations apply mottenai --local",
    "db:migrate:remote": "wrangler d1 migrations apply mottenai --remote",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types worker/env.d.ts --env-interface Env"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "arctic": "^3.7.0",
    "hono": "^4.13.16",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
